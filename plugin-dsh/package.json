{
  "name": "@agentspec/agentspec-dsh",
  "version": "3.4.1",
  "description": "AgentSpec Spec-Driven Development workflow as a DeepSeek Harness (dsh) bundle — skills + native slash commands.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/commands.js",
  "exports": {
    "./lib/skills": "./lib/skills.js",
    "./lib/commands": "./lib/commands.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "generate": "python3 ../scripts/generate-dsh-bundle.py"
  },
  "dependencies": {
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/cordis": "4.0.1"
  }
}
